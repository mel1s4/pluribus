VITE_API_BASE_URL=https://chante-api.vzs.mx
# WebSockets (Echo) for place live orders only. Chat uses HTTPS GET /api/chats/stream (SSE + Redis).
# Uncomment if Reverb/WSS on VITE_WS_PORT is not exposed yet (avoids repeated connection errors in the console):
# VITE_REALTIME_ENABLED=false
VITE_WS_HOST=chante-api.vzs.mx
VITE_WS_PORT=6001
VITE_WS_SCHEME=wss
VITE_PUSHER_APP_KEY=pluribus-key
