APP_NAME=Pluribus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9122

# SPA origin (invitation links, password reset, CORS). Production: https://pluribus.vzs.mx
FRONTEND_URL=http://localhost:9123

# Production: pluribus.vzs.mx,www.pluribus.vzs.mx (legacy chante.vzs.mx redirects at Apache)
# Add each community custom SPA host (e.g. river.example.org). Verified hosts in community_domains are merged at boot.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:9123,127.0.0.1,127.0.0.1:9123

# Hosts that serve the main Pluribus app (not a single-community custom domain)
PLURIBUS_PLATFORM_HOSTS=localhost,127.0.0.1,pluribus.vzs.mx,www.pluribus.vzs.mx,chante.vzs.mx,www.chante.vzs.mx,chante-api.vzs.mx

SESSION_SECURE_COOKIE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pluribus
DB_USERNAME=pluribus
DB_PASSWORD=pluribus_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

PERSONIFICATION_TOUCH_INTERVAL_SECONDS=30

# Ed25519 operator key for signed wallet ledger (base64 64-byte secret from `php artisan wallet:ledger-gen-keys`)
WALLET_LEDGER_SECRET_KEY=
WALLET_LEDGER_PUBLIC_KEY=
WALLET_LEDGER_ENTRIES_PER_BLOCK=1

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=8
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
